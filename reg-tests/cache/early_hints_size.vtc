varnishtest "Cache early-hints size: hints survive main-store eviction"
# "early-hints on size N" sizes a separate hints cache of N bytes. Hint entries live there and are never candidates for the
# main store's eviction. Storing thirteen 400KB bodies into a 1MB cache can
# keep only the last two responses, but all thirteen hint entries must
# survive: thirteen tiny records easily fit the 1% hints cache.

feature ignore_unknown_macro
feature cmd "command -v curl && command -v socat"

server s1 -repeat 13 {
    rxreq
    txresp \
        -hdr "Cache-Control: public, max-age=300" \
        -hdr "Link: </style.css>; rel=preload; as=style" \
        -bodylen 400000
} -start

haproxy h1 -conf {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif
        stats socket "${tmpdir}/h1/stats" level admin

    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    frontend fe
        bind "fd@${fe}"
        default_backend test

    backend test
        # Force a fresh backend connection per request so server -repeat 13
        # actually sees 13 separate connections.
        http-reuse never
        http-request cache-use my_cache
        server www ${s1_addr}:${s1_port}
        http-response cache-store my_cache

    cache my_cache
        admission-filter off
        total-max-size 1
        max-age 300
        max-object-size 500000
        early-hints on size 16384
} -start


shell {
    for i in $(seq 1 13); do
        curl -fs -o /dev/null "http://${h1_fe_addr}:${h1_fe_port}/page$i"
    done

    # Tiny pause to let cache_store_http_end settle for the last request.
    sleep 0.1

    out=$(echo "show cache" | socat -t 5 "${tmpdir}/h1/stats" -)
    # Entry lines carry a hash; only the full entries carry a vary key.
    entries=$(echo "$out" | grep -E "^0x[0-9a-f]+ hash:0x")
    hints=$(echo "$entries" | grep -vc " vary:0x")
    full=$(echo "$entries" | grep -c " vary:0x")

    if [ "$hints" -ne 13 ]; then
        echo "size test: expected 13 hint entries, got $hints"
        echo "$out"
        exit 1
    fi
    if [ "$full" -ne 2 ]; then
        echo "size test: expected 2 full entries, got $full"
        echo "$out"
        exit 1
    fi
}
