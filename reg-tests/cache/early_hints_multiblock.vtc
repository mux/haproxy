varnishtest "Cache HTTP 103 Early Hints: multi-segment hint entries"
# Hint records are stored as entries of the hints cache, which is sized by
# "ratio" and uses small segments (4KB here). A Link value larger than one
# segment makes the hint entry span a segment chain: the store must write it
# whole and the replay must read it back across the chain - the assertion on
# the value's tail fails if the entry is truncated at a segment boundary.
# The large X-Pad header in front of the Link additionally checks that hint
# extraction walks the entire header list instead of stopping early.
#
# The response itself is larger than max-object-size, so the main store never
# caches it: every fetch is a main-store miss and every fetch after the first
# replays the hint entry. Neither expiry nor eviction is involved.

feature ignore_unknown_macro

server s1 -repeat 2 {
    rxreq
    expect req.url == "/multiblock"
    txresp -hdr "Cache-Control: public, max-age=60" \
           -hdr "X-Pad: " \
           -hdr "Link: <>; rel=preload; as=style" \
           -bodylen 100
} -start

haproxy h1 -conf {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client  "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server  "${HAPROXY_TEST_TIMEOUT-5s}"

    frontend fe
        bind "fd@${fe}"
        default_backend test

    backend test
        http-reuse never
        http-request cache-use my_cache
        server www ${s1_addr}:${s1_port}
        http-response cache-store my_cache

    cache my_cache
        total-max-size 1
        max-age 300
        max-object-size 4096
        early-hints on ratio 25
} -start

client c1 -connect ${h1_fe_sock} {
    # Populate the hint entry; no 103 on the first sighting.
    txreq -url "/multiblock"
    rxresp
    expect resp.status == 200
} -run

client c2 -connect ${h1_fe_sock} {
    # The hint record spans two 4KB segments; both its head and its tail
    # must replay intact.
    txreq -url "/multiblock"
    rxresphdrs
    expect resp.status == 103
    expect resp.http.link ~ "^<x{200}"
    expect resp.http.link ~ "; rel=preload; as=style$"
    rxresp
    expect resp.status == 200
} -run
